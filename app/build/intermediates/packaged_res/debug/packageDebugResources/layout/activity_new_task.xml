<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ah_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nueva tarea" android:textColor="@color/ah_navy" android:textSize="28sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="¿Qué tienes que hacer?"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <EditText android:id="@+id/etTaskTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:hint="Escribe tu actividad" android:padding="16dp"
            android:background="@drawable/bg_card" android:inputType="textCapSentences"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="¿En cuánto tiempo?"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <RadioGroup android:id="@+id/rgDuration" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="15 min" android:checked="true"/>
            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="30 min"/>
            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1 hora"/>
        </RadioGroup>
        <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2 horas"/>
            <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Elegir hora"/>
        </RadioGroup>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Avisos que no se me pasan"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <Switch android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Avisarme a la mitad del tiempo" android:checked="true"/>
        <Switch android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aviso fuerte cuando falten 10 min" android:checked="true"/>
        <Switch android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cuenta regresiva en pantalla de bloqueo"/>
        <Button android:id="@+id/btnCreateTask" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="Crear y empezar la cuenta" android:textAllCaps="false"
            android:textColor="@android:color/white" android:backgroundTint="@color/ah_navy"/>
        <Button android:id="@+id/btnCancelTask" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Cancelar" android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
