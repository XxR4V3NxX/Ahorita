<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ah_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nueva tarea" android:textColor="@color/ah_navy" android:textSize="28sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="¿Qué tienes que hacer?"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <EditText android:id="@+id/etTaskTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:hint="Escribe tu actividad" android:padding="16dp"
            android:background="@drawable/bg_card" android:inputType="textCapSentences"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="¿En cuánto tiempo?"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <RadioGroup android:id="@+id/rgDuration" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/rb15" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="15 min" android:checked="true"/>
            <RadioButton android:id="@+id/rb30" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="30 min"/>
            <RadioButton android:id="@+id/rb60" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="1 hora"/>
            <RadioButton android:id="@+id/rb120" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="2 horas"/>
            <RadioButton android:id="@+id/rbCustom" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Elegir hora"/>
        </RadioGroup>

        <!-- NUEVO: muestra la hora elegida. Es clicable para volver a cambiarla -->
        <TextView android:id="@+id/tvCustomTime" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="32dp"
            android:layout_marginTop="4dp" android:textColor="@color/ah_muted"
            android:textStyle="bold" android:visibility="gone"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Avisos que no se me pasan"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <Switch android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Avisarme a la mitad del tiempo" android:checked="true"/>
        <Switch android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aviso fuerte cuando falten 10 min" android:checked="true"/>
        <Switch android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cuenta regresiva en pantalla de bloqueo"/>
        <!--  pasos pequeños opcionales -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Pasos pequeños (opcional)"
            android:textColor="@color/ah_navy" android:textSize="19sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/etStep" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="Ej. Guardar la laptop" android:padding="14dp"
                android:background="@drawable/bg_card" android:inputType="textCapSentences"/>
            <Button android:id="@+id/btnAddStep" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="Agregar" android:textAllCaps="false"/>
        </LinearLayout>
        <!--  pasos ya agregados -->
        <LinearLayout android:id="@+id/containerNewSteps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
        <Button android:id="@+id/btnCreateTask" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="Crear y empezar la cuenta" android:textAllCaps="false"
            android:textColor="@android:color/white" android:backgroundTint="@color/ah_navy"/>
        <Button android:id="@+id/btnCancelTask" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Cancelar" android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
