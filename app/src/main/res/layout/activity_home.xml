<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ah_background" android:orientation="vertical">

    <!-- CAMBIO: el contenido vive en un ScrollView que ocupa el espacio libre.
         Así solo se desplaza esta parte y el menú de abajo se queda fijo. -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ahorita" android:textColor="@color/ah_navy" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="martes 20 de octubre · 7:52 a. m."
                android:textColor="@color/ah_muted" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="Lo urgente, ahorita"
                android:textColor="@color/ah_navy" android:textSize="22sp" android:textStyle="bold"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:background="@drawable/bg_card_primary"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/tvUrgentLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AHORA" android:textColor="@color/ah_navy"
                    android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:id="@+id/tvUrgentTask" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:text="Salir para la clase de Diseño" android:textColor="@color/ah_navy"
                    android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvUrgentTime" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="42 min" android:textColor="@color/ah_navy" android:textSize="34sp"
                    android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Aviso fuerte a los 10 min" android:textColor="@color/ah_muted"/>
                <Button android:id="@+id/btnStartTask" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:text="Empezar ahora" android:textAllCaps="false"
                    android:textColor="@android:color/white" android:backgroundTint="@color/ah_navy"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Siguientes" android:textColor="@color/ah_navy"
                    android:textSize="20sp" android:textStyle="bold"/>
                <Button android:id="@+id/btnSeeAll" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Ver todo" android:textAllCaps="false"
                    android:textColor="@color/ah_navy"
                    android:background="@drawable/bg_btn_pill_outline"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:minHeight="0dp" android:minWidth="0dp"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- Las tarjetas de tareas se agregan aquí desde MainActivity -->
            <LinearLayout android:id="@+id/containerSiguientes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <!-- CAMBIO: la barra de navegación ahora está fuera del ScrollView, así que queda fija -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/ah_background" android:gravity="center"
        android:orientation="horizontal" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="12dp" android:paddingBottom="16dp">

        <Button android:id="@+id/btnToday" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:text="Hoy" android:textAllCaps="false"
            android:textColor="@color/ah_navy"
            android:background="@drawable/bg_btn_pill_outline"
            android:backgroundTint="@null" android:stateListAnimator="@null"
            android:minHeight="0dp" android:paddingTop="12dp" android:paddingBottom="12dp"/>

        <Button android:id="@+id/btnNewTask" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:text="+" android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_pill_filled"
            android:backgroundTint="@null" android:stateListAnimator="@null"
            android:minHeight="0dp" android:paddingTop="12dp" android:paddingBottom="12dp"/>

        <Button android:id="@+id/btnStreaks" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:text="Rachas" android:textAllCaps="false"
            android:textColor="@color/ah_navy"
            android:background="@drawable/bg_btn_pill_outline"
            android:backgroundTint="@null" android:stateListAnimator="@null"
            android:minHeight="0dp" android:paddingTop="12dp" android:paddingBottom="12dp"/>
    </LinearLayout>
</LinearLayout>