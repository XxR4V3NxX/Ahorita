<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ah_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="22dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ÚLTIMOS MINUTOS" android:textColor="@color/ah_orange"
            android:textSize="16sp" android:textStyle="bold"/>

        <TextView android:id="@+id/tvCountdownTask" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:gravity="center" android:text="Salir para la clase de Diseño"
            android:textColor="@color/ah_navy" android:textSize="23sp" android:textStyle="bold"/>

        <!-- NUEVO: contenedor del arco y del texto del contador -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="240dp"
            android:layout_marginTop="16dp">

            <!-- NUEVO: arco que se acorta con el tiempo -->
            <com.ahorita.app.ArcProgressView
                android:id="@+id/arcCountdown"
                android:layout_width="match_parent" android:layout_height="match_parent"/>

            <!-- MOVIDO: estos tres TextView ahora van centrados dentro del FrameLayout -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="faltan" android:textColor="@color/ah_muted"
                    android:textSize="16sp"/>
                <TextView android:id="@+id/tvCountdown" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="09:12" android:textColor="@color/ah_orange"
                    android:textSize="64sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvCountdownUnit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="minutos : segundos" android:textColor="@color/ah_muted"/>
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/tvStepsTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="Pasos pequeños" android:textColor="@color/ah_navy"
            android:textSize="20sp" android:textStyle="bold"/>

        <!-- CAMBIO: los pasos se crean desde MainActivity según la tarea -->
        <LinearLayout android:id="@+id/containerSteps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
        <Button android:id="@+id/btnDone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:minHeight="44dp" android:text="Ya lo hice" android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_round_filled"
            android:backgroundTint="@null" android:stateListAnimator="@null"/>

        <Button android:id="@+id/btnAddFive" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:minHeight="44dp" android:text="+5 min" android:textAllCaps="false"
            android:textColor="@color/ah_navy"
            android:background="@drawable/bg_btn_pill_outline"
            android:backgroundTint="@null" android:stateListAnimator="@null"/>

        <Button android:id="@+id/btnBackHome" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:minHeight="44dp" android:text="Volver al inicio" android:textAllCaps="false"
            android:textColor="@color/ah_navy"
            android:background="@drawable/bg_btn_pill_outline"
            android:backgroundTint="@null" android:stateListAnimator="@null"/>
    </LinearLayout>
</ScrollView>